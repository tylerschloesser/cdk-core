{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["e2e/**"],
      "rules": {
        // A Playwright fixture callback takes a parameter named `use`, which the
        // React plugin reads as React's `use()` hook. There is no React in this
        // package, and the shape is not negotiable — Playwright calls it.
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
